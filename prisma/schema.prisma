generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  autosaveMs   Int         @default(300000)
  isSiteAdmin  Boolean     @default(false)
  disabled     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  memberships        OrgMember[]
  accounts           Account[]
  sessions           Session[]
  passwordResetOtps  PasswordResetOtp[]
}

model PasswordResetOtp {
  id           String    @id @default(cuid())
  userId       String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuthEmailThrottle {
  id        String   @id @default(cuid())
  emailHash String
  kind      String
  createdAt DateTime @default(now())

  @@index([emailHash, kind, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Org {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  members    OrgMember[]
  luminaires Luminaire[]
  projects   Project[]
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Luminaire {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  sourceFormat    String
  fileKey         String
  originalName    String
  photometricJson String
  watts           Float?
  lumens          Float?
  lightxProductId String?
  origin          String   @default("upload")
  libraryFamily   String?
  libraryBeamDeg  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Project {
  id          String          @id @default(cuid())
  orgId       String
  name        String
  sceneJson   String
  resultsJson String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  exports     ProjectExport[]
  assets      ProjectAsset[]

  @@index([orgId])
}

model ProjectAsset {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  fileKey   String
  fileName  String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectExport {
  id        String   @id @default(cuid())
  projectId String
  type      String
  fileKey   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model UiTip {
  helpKey   String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteTrafficDaily {
  date      String @id
  pageViews Int    @default(0)
  visitors  Int    @default(0)
}

model SiteTrafficVisitorDay {
  date        String
  visitorHash String

  @@id([date, visitorHash])
}

