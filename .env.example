DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
STORAGE_DIR="./storage"

# SMTP for transactional mail (Office 365 STARTTLS). Leave unset to disable sending.
# From must be a mailbox the SMTP account is allowed to send as.
EMAIL_SERVER_HOST="smtp.office365.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@example.com"
EMAIL_SERVER_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="LUXSIM <you@example.com>"

# Optional fallback only for room-layout analysis when no architectural layout
# is found in a DXF/DWG. The official product path is Admin → Settings
# (Room-analysis AI): enable the service, choose provider/model, and save a key.
# Leave these unset if you use the admin setting. Never commit a real key.
# XAI_API_KEY=
# OPENAI_API_KEY=
